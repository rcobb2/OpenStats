#!/bin/bash
set -e

PLIST_PATH="/Library/LaunchDaemons/com.openlabstats.agent.plist"
LABEL="com.openlabstats.agent"
LOG_DIR="/var/log/openlabstats"
INSTALL_DIR="/usr/local/openlabstats"
CONFIG_PATH="$INSTALL_DIR/configs/agent.yaml"
CONFIG_BACKUP="/tmp/openlabstats-agent-config.bak"

# Create log directory if not present.
mkdir -p "$LOG_DIR"
chmod 755 "$LOG_DIR"

# Ensure install dir has correct permissions.
chmod 755 "$INSTALL_DIR"
chmod 755 "$INSTALL_DIR/openlabstats-agent"

# Preserve only the site-specific building/room fields from a pre-existing
# config across upgrades. We intentionally do NOT restore the whole file —
# doing so previously clobbered server.reportURL (and any other setting)
# with whatever was installed before, silently pointing upgraded agents at
# a stale/unreachable server URL. The freshly-installed package's
# agent.yaml (with the current defaults) is left in place; we just patch
# building/room into it if the backup had non-empty values.
# If no backup exists this is a fresh install — keep the default config as-is.
if [[ -f "$CONFIG_BACKUP" ]]; then
    OLD_BUILDING="$(sed -n 's/^[[:space:]]*building:[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$CONFIG_BACKUP" | head -n1)"
    OLD_ROOM="$(sed -n 's/^[[:space:]]*room:[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$CONFIG_BACKUP" | head -n1)"

    if [[ -n "$OLD_BUILDING" ]]; then
        sed -i '' "s/^\([[:space:]]*building:[[:space:]]*\).*\$/\1\"${OLD_BUILDING}\"/" "$CONFIG_PATH"
    fi
    if [[ -n "$OLD_ROOM" ]]; then
        sed -i '' "s/^\([[:space:]]*room:[[:space:]]*\).*\$/\1\"${OLD_ROOM}\"/" "$CONFIG_PATH"
    fi

    rm -f "$CONFIG_BACKUP"
fi

# Set correct plist permissions (must be root:wheel, mode 644 for launchd).
chown root:wheel "$PLIST_PATH"
chmod 644 "$PLIST_PATH"

# If the daemon is already loaded (upgrade), bootout first.
if launchctl list "$LABEL" &>/dev/null; then
    launchctl bootout "system/$LABEL" || true
fi

# Bootstrap the daemon.
launchctl bootstrap system "$PLIST_PATH"

# Allow the agent through the macOS Application Firewall so Prometheus can
# scrape its metrics endpoint. Without this, the firewall silently drops
# inbound connections to port 9183 when the daemon installs non-interactively.
SOCKETFILTERFW="/usr/libexec/ApplicationFirewall/socketfilterfw"
if [[ -x "$SOCKETFILTERFW" ]]; then
    "$SOCKETFILTERFW" --add "$INSTALL_DIR/openlabstats-agent" 2>/dev/null || true
    "$SOCKETFILTERFW" --unblock "$INSTALL_DIR/openlabstats-agent" 2>/dev/null || true
fi

exit 0
