<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- ================================================================
       OpenLabStats Agent MSI Installer
       
       Silent install example:
         msiexec /i openlabstats-agent.msi /qn SERVERADDRESS=server.campus.edu PORT=9183
       
       Properties:
         SERVERADDRESS  - Central management server URL (optional)
         PORT           - Prometheus metrics port (default: 9183)
         BUILDING       - Lab building name (optional)
         ROOM           - Lab room number (optional)
         INSTALLDIR     - Installation directory (default: C:\Program Files\OpenLabStats)
       ================================================================ -->

  <Package Name="OpenLabStats Agent"
           Manufacturer="OpenLabStats"
           Version="$(var.Version)"
           UpgradeCode="E7A14B3C-5D62-4F89-A1C0-8B3E6F9D2A71"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenLabStats Agent is already installed."
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <!-- ============================================================
         Public properties for admin customization via command line.
         ============================================================ -->
    <Property Id="SERVERADDRESS" Secure="yes" />
    <Property Id="PORT" Value="9183" Secure="yes" />
    <Property Id="BUILDING" Secure="yes" />
    <Property Id="ROOM" Secure="yes" />

    <!-- ============================================================
         Directory structure
         ============================================================ -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="OpenLabStats">
        <Directory Id="ConfigDir" Name="configs" />
        <Directory Id="DataDir" Name="data" />
        <Directory Id="LogDir" Name="logs" />
      </Directory>
    </StandardDirectory>

    <!-- ============================================================
         Agent binary
         ============================================================ -->
    <ComponentGroup Id="AgentBinary" Directory="INSTALLDIR">
      <Component Id="AgentExe" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <File Id="AgentExeFile"
              Source="$(var.BuildOutput)\openlabstats-agent.exe"
              KeyPath="yes" />

        <!-- Register as a Windows service -->
        <ServiceInstall Id="AgentService"
                        Type="ownProcess"
                        Name="OpenLabStats"
                        DisplayName="OpenLabStats Agent"
                        Description="Open-source software usage tracking agent for higher education"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Arguments="--config &quot;[ConfigDir]agent.yaml&quot;" />

        <ServiceControl Id="AgentServiceControl"
                        Name="OpenLabStats"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================
         Configuration files
         ============================================================ -->
    <ComponentGroup Id="ConfigFiles" Directory="ConfigDir">
      <Component Id="AgentYaml" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <File Id="AgentYamlFile"
              Source="$(var.SourceRoot)\configs\agent.yaml"
              KeyPath="yes" />
      </Component>

      <Component Id="SoftwareMap" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
        <File Id="SoftwareMapFile"
              Source="$(var.SourceRoot)\configs\software-map.json"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================
         Empty directories (data and logs)
         ============================================================ -->
    <ComponentGroup Id="DataDirs">
      <Component Id="DataDirComp" Directory="DataDir" Guid="D4E5F6A7-B8C9-0123-DEFA-234567890123">
        <CreateFolder />
      </Component>
      <Component Id="LogDirComp" Directory="LogDir" Guid="E5F6A7B8-C9D0-1234-EFAB-345678901234">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ============================================================
         Firewall rule
         ============================================================ -->
    <ComponentGroup Id="FirewallRules" Directory="INSTALLDIR">
      <Component Id="FirewallRule" Guid="F6A7B8C9-D0E1-2345-FABC-456789012345">
        <fire:FirewallException Id="AgentFirewall"
                                Name="OpenLabStats Agent"
                                Protocol="tcp"
                                Port="[PORT]"
                                Scope="any"
                                Description="Allow Prometheus to scrape OpenLabStats agent metrics" />
      </Component>
    </ComponentGroup>

    <!-- ============================================================
         Agent configuration via the registry.

         The agent reads HKLM\SOFTWARE\OpenLabStats and layers these values
         over agent.yaml (see internal/config/override_windows.go).

         This replaced a deferred PowerShell custom action that regex-patched
         agent.yaml in place with Return="ignore". Because failures were
         ignored, a blocked or failing PowerShell left reportURL empty while
         msiexec still returned success — the agent installed, the service
         started, and it silently never registered. RegistryValue is native
         MSI: transactional, logged, and rolled back on failure.

         Values are written as strings so an unset property yields "" rather
         than 0, which the agent could not distinguish from a real value.
         ============================================================ -->
    <ComponentGroup Id="AgentConfigRegistry" Directory="INSTALLDIR">
      <Component Id="AgentRegistryConfig" Guid="0B7F4E1A-93C6-4D28-8E5B-7A1C4F60D932" Bitness="always64">
        <RegistryKey Root="HKLM" Key="SOFTWARE\OpenLabStats" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="ServerAddress" Value="[SERVERADDRESS]" Type="string" KeyPath="yes" />
          <RegistryValue Name="MappingUpdateURL" Value="[MAPPINGUPDATEURL]" Type="string" />
          <RegistryValue Name="Port" Value="[PORT]" Type="string" />
          <RegistryValue Name="Building" Value="[BUILDING]" Type="string" />
          <RegistryValue Name="Room" Value="[ROOM]" Type="string" />
          <!-- Recorded for support: which install set these values. -->
          <RegistryValue Name="InstalledVersion" Value="[ProductVersion]" Type="string" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Derive the mapping URL from SERVERADDRESS unless explicitly overridden. -->
    <Property Id="MAPPINGUPDATEURL" Secure="yes" />
    <SetProperty Id="MAPPINGUPDATEURL"
                 Value="[SERVERADDRESS]/api/v1/mappings/agent"
                 Before="CostFinalize"
                 Condition="SERVERADDRESS AND NOT MAPPINGUPDATEURL" />

    <!-- ============================================================
         Feature tree
         ============================================================ -->
    <Feature Id="Complete" Title="OpenLabStats Agent" Level="1">
      <ComponentGroupRef Id="AgentBinary" />
      <ComponentGroupRef Id="ConfigFiles" />
      <ComponentGroupRef Id="AgentConfigRegistry" />
      <ComponentGroupRef Id="DataDirs" />
      <ComponentGroupRef Id="FirewallRules" />
    </Feature>

  </Package>
</Wix>
